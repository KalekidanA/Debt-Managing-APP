# Copy this file to keystore.properties (same directory) and fill in real
# values to enable signed release builds. keystore.properties is gitignored
# — never commit your actual keystore password or file.
#
# The CI workflow (.github/workflows/build-mobile.yml) writes this file
# automatically from GitHub Actions secrets, so you generally won't need
# to create it by hand except for local release builds.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=zero
keyPassword=CHANGE_ME
